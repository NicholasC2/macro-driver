{
  "name": "macro-driver",
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "build:config": "esbuild src/config.ts --bundle --platform=node --format=cjs --outfile=dist/config.js"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/node-notifier": "^8.0.5",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "pkg": {
    "scripts": [
      "dist/macro-driver.js"
    ],
    "assets": [
      "dist/config.js"
    ]
  },
  "dependencies": {
    "node-hid": "^3.4.0",
    "node-notifier": "^10.0.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "node-hid@3.4.0": true
  }
}
