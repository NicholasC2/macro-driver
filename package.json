    "build:config": "esbuild src/config.ts --bundle --packages=external --platform=node --outfile=dist/config.js"
  },
  "dependencies": {
    "node-hid": "^3.4.0",
    "node-notifier": "^12.0.0",
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/node-notifier": "^8.0.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "node-hid@3.4.0": true,
    "esbuild@0.28.2": true
  }
}
